# Copy to .env to change these values. Every value below is also the default in docker-compose.yml.

# Mock database
POSTGRES_DB=sap_mock
POSTGRES_USER=sap_mock
POSTGRES_PASSWORD=sap_mock_password
# 5433 because a local PostgreSQL often holds 5432.
DB_HOST_PORT=5433

# Mock Service Layer
MOCK_SL_HOST_PORT=50000
MOCK_COMPANY_DB=TEST
MOCK_SESSION_TIMEOUT_MINUTES=30

# Backend application
API_HOST_PORT=8080

# Which Service Layer the backend talks to. For real SAP change only these three, for example:
#   SL_BASE_URL=https://<server>:50000/b1s/v2/
#   SL_COMPANY_DB=<company database>
#   SL_SKIP_TLS_VERIFY=true    (real Service Layer usually has a self-signed certificate)
SL_BASE_URL=http://mock-sl:8080/b1s/v2/
SL_COMPANY_DB=TEST
SL_SKIP_TLS_VERIFY=false

# Grocery store script only: docker compose run --rm --build grocery-store
SL_USERNAME=manager
SL_PASSWORD=1234
# What a real company database needs on document lines. Leave the tax values empty on the mock.
SL_WAREHOUSE=01
SL_TAX_CODE=
SL_VAT_GROUP=
# Change the prefix to run the script again on a database that already has the codes.
GROCERY_PREFIX=G
# The fixed "current month" of the data. The month before it is used too.
GROCERY_CURRENT_MONTH=2026-11
# The parent of the cash accounts the script creates. On real SAP, a title account from its chart.
GROCERY_CASH_PARENT_ACCOUNT=1000
